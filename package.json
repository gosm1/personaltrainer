{
  "name": "lock-in-30",
  "private": true,
  "version": "1.0.0",
  "description": "Personal 30-week training tracker. Runs fully in the browser; data stays on your device.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "exercises:sync": "node scripts/sync-exercises.mjs",
    "exercises:check": "node scripts/sync-exercises.mjs --check"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
